{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx,js,jsx,json,md}": [
      "cd client && npm run lint --if-present",
      "cd client && prettier --write"
    ],
    "server/**/*.{ts,js,json,md}": [
      "cd server && npm run lint --if-present",
      "cd server && prettier --write"
    ]
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ms": "^2.1.3"
  }
}
